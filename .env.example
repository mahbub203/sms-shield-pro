# Environment configuration for SMS Shield
PROJECT_NAME="SMS Shield"
VERSION="1.0.0"

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./sms_shield.db
# DATABASE_URL=postgresql://user:password@localhost:5432/smsshield

# Security & JWT Tokens
SECRET_KEY=sms-shield-super-secret-key-cybersecurity-999-secure-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Administrator Credentials (auto-seeded on first run)
ADMIN_EMAIL=admin@smsshield.io
ADMIN_PASSWORD=Admin@Shield2026!

# Port Configuration
PORT=8088
FRONTEND_PORT=3000
